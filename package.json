{
  "name": "mathjax-complete",
  "version": "0.1.6",
  "private": true,
  "description": "LaTeX command suggestions for Obsidian math.",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "tsx --test tests/*.test.ts",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@mathjax/src": "4.1.3",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "mathjax-full": "3.2.2",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/t0masGutierrez/mathjax-complete.git"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
